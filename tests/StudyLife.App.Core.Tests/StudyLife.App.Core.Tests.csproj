<Project Sdk="Microsoft.NET.Sdk">

    <!-- Unit tests of the device-independent decisions in src/StudyLife.App.Core. They run on any
         OS with the plain .NET SDK (no MAUI workload), see the test-unit job in ci-cd.yml. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- packages.lock.json pins every package of the tests with its content hash; CI restores
             in locked mode (test-unit). Dependabot regenerates it with each bump of this project.
             The app project has none: its restore graph includes the pinned studylife client,
             whose packages change with every studylife bump (a Renovate pull request, which does
             not regenerate lock files), and CI narrows its target frameworks per job. -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\StudyLife.App.Core\StudyLife.App.Core.csproj" />
    </ItemGroup>

</Project>
