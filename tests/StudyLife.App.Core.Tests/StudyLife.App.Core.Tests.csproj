<Project Sdk="Microsoft.NET.Sdk">

    <!-- Unit tests of the device-independent decisions in src/StudyLife.App.Core. They run on any
         OS with the plain .NET SDK (no MAUI workload), see the test-unit job in ci-cd.yml. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\StudyLife.App.Core\StudyLife.App.Core.csproj" />
    </ItemGroup>

</Project>
