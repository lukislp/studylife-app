<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Only standard HTTPS (system TLS) and hashing, no own cryptography: exempt from export
         compliance, so TestFlight builds need no manual answer. -->
    <!-- The languages of the app's UI (the 26 of StudyLife.Client/i18ntext). Declaring them makes the
         system offer Settings, StudyLife, Language; the app takes its language from there and has no
         picker of its own (Services/SystemAppLanguage.cs). Keep in step with UiLanguage.All. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>de</string>
        <string>fr</string>
        <string>es</string>
        <string>it</string>
        <string>pt</string>
        <string>nl</string>
        <string>da</string>
        <string>sv</string>
        <string>fi</string>
        <string>el</string>
        <string>pl</string>
        <string>cs</string>
        <string>sk</string>
        <string>hu</string>
        <string>ro</string>
        <string>bg</string>
        <string>hr</string>
        <string>sl</string>
        <string>et</string>
        <string>lv</string>
        <string>lt</string>
        <string>mt</string>
        <string>ga</string>
        <string>uk</string>
        <string>ru</string>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Required for Mac App Store / TestFlight uploads. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.education</string>
    <key>UIDeviceFamily</key>
    <array>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>
    <!-- Notes dictation (getUserMedia in the web view). Needs the entitlement
         com.apple.security.device.audio-input, in Entitlements.plist (App Sandbox) and in
         scripts/apple/entitlements/maccatalyst-developer-id.plist (hardened runtime). The base
         language is German like the iOS Info.plist; the translations are the same
         InfoPlist.strings files (Platforms/iOS/*.lproj), bundled into this target by the csproj. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>StudyLife nimmt deine Stimme auf, um Notizen per Spracheingabe zu diktieren.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>StudyLife nutzt als Ersatzlösung die Spracherkennung, um deine Spracheingabe in Notiztext umzuwandeln.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>StudyLife verbindet sich mit deinem StudyLife-Server in deinem lokalen Netzwerk.</string>
    <!-- Return channel of the passkey login (see iOS/Info.plist) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>app.studylife.mobile.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>studylife</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
