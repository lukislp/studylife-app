<?xml version="1.0" encoding="utf-8"?>
<!-- Static home screen quick actions - counterpart to the "shortcuts" from the PWA
     manifest (manifest.json), which don't work as an installed PWA on iOS/partly on
     Android. Explicit intents (targetPackage/targetClass) pointing at MainActivity with
     the route as a studylife://shortcut/... data URI; handled in
     MainActivity.DispatchShortcut. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="focus"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/shortcut_focus_short"
        android:shortcutLongLabel="@string/shortcut_focus_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.studylife.mobile"
            android:targetClass="app.studylife.mobile.MainActivity"
            android:data="studylife://shortcut/focus" />
    </shortcut>
    <shortcut
        android:shortcutId="newnote"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/shortcut_note_short"
        android:shortcutLongLabel="@string/shortcut_note_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.studylife.mobile"
            android:targetClass="app.studylife.mobile.MainActivity"
            android:data="studylife://shortcut/newnote" />
    </shortcut>
    <shortcut
        android:shortcutId="calendar"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/shortcut_calendar_short"
        android:shortcutLongLabel="@string/shortcut_calendar_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.studylife.mobile"
            android:targetClass="app.studylife.mobile.MainActivity"
            android:data="studylife://shortcut/calendar" />
    </shortcut>
    <shortcut
        android:shortcutId="stats"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/shortcut_stats_short"
        android:shortcutLongLabel="@string/shortcut_stats_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.studylife.mobile"
            android:targetClass="app.studylife.mobile.MainActivity"
            android:data="studylife://shortcut/stats" />
    </shortcut>
    <shortcut
        android:shortcutId="weekplan"
        android:enabled="true"
        android:icon="@mipmap/appicon"
        android:shortcutShortLabel="@string/shortcut_weekplan_short"
        android:shortcutLongLabel="@string/shortcut_weekplan_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="app.studylife.mobile"
            android:targetClass="app.studylife.mobile.MainActivity"
            android:data="studylife://shortcut/weekplan" />
    </shortcut>
</shortcuts>
