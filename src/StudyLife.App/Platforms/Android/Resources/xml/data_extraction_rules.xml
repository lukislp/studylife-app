<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app leaves the device through Android backup or device-to-device transfer
     (2026-11-16 audit M10). The WebView profile (app_webview: localStorage with the session token,
     the offline caches) and the app preferences belong to this installation; a backup restored on
     another device would carry a live session along. android:allowBackup="false" covers Android 11
     and older; Android 12+ reads these rules instead, for cloud backup AND device transfer (which
     allowBackup no longer controls). After a restore or transfer the user signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
